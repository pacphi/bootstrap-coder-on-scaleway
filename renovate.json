{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Managed from pacphi/mise-dotfiles. Replaces Dependabot version updates (2026-10-21).",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "github-actions: dev commit prefix",
      "matchCategories": [
        "ci"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "commitMessagePrefix": "chore(deps-dev):"
    },
    {
      "description": "github-actions: settings",
      "matchCategories": [
        "ci"
      ],
      "schedule": [
        "* 0-5 * * 1"
      ],
      "labels": [
        "dependencies",
        "github-actions",
        "ci/cd",
        "security"
      ],
      "reviewers": [
        "security-team"
      ],
      "assignees": [
        "devops-team"
      ],
      "commitMessagePrefix": "chore(deps):"
    },
    {
      "description": "github-actions: group github-actions",
      "matchCategories": [
        "ci"
      ],
      "groupName": "github-actions",
      "matchPackageNames": [
        "*"
      ]
    },
